---
import '../styles/tokens.css';
import { getRelativeLocaleUrl } from 'astro:i18n';
import CookieConsent from '../components/CookieConsent.astro';
import type { CookieConsentCopy, Project } from '../data/content';

interface Props {
  title: string;
  description: string;
  lang: 'en' | 'es';
  projects?: Project[];
  cookieConsent: CookieConsentCopy;
}

const { title, description, lang, projects, cookieConsent } = Astro.props;
const gtmId = 'GTM-KP4QVKT9';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const altLang = lang === 'en' ? 'es' : 'en';
const localeRelativePath = lang === 'es' ? Astro.url.pathname.replace(/^\/es/, '') || '/' : Astro.url.pathname;
const altPath = getRelativeLocaleUrl(altLang, localeRelativePath, { normalizeLocale: false });
const ogImageURL = new URL('/images/og-card.png', Astro.site);
const ogLocale = lang === 'en' ? 'en_US' : 'es_ES';
const ogLocaleAlternate = lang === 'en' ? 'es_ES' : 'en_US';

const personById = 'https://dahiana.work/#person';

const personCopy = {
  en: {
    jobTitle: 'Low-code & AI builder',
    description:
      'Low-code and AI builder. Started in marketing, grew into a CMO role, moved into building products with low-code tools, design, and teaching.',
    knowsAbout: [
      'Bubble',
      'Webflow',
      'WordPress',
      'Framer',
      'n8n',
      'AI agentic workflows',
      'SEO',
      'AEO',
      'Content marketing',
    ],
  },
  es: {
    jobTitle: 'Constructora low-code y de IA',
    description:
      'Constructora low-code y de IA. Empezó en marketing, llegó a un puesto de CMO, y pasó a construir productos con herramientas low-code, diseño y enseñanza.',
    knowsAbout: [
      'Bubble',
      'Webflow',
      'WordPress',
      'Framer',
      'n8n',
      'Workflows agénticos de IA',
      'SEO',
      'AEO',
      'Marketing de contenido',
    ],
  },
}[lang];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://dahiana.work/#website',
      url: 'https://dahiana.work',
      name: 'Dahiana Porto',
      inLanguage: lang,
    },
    {
      '@type': 'ProfilePage',
      '@id': `${canonicalURL}#profile`,
      dateModified: new Date().toISOString(),
      inLanguage: lang,
      mainEntity: { '@id': personById },
    },
    {
      '@type': 'Person',
      '@id': personById,
      name: 'Dahiana Porto',
      url: 'https://dahiana.work',
      email: 'mailto:hello@dahiana.work',
      jobTitle: personCopy.jobTitle,
      description: personCopy.description,
      knowsAbout: personCopy.knowsAbout,
      sameAs: ['https://www.linkedin.com/in/low-code-ai-automation-dahiana-porto/'],
    },
    ...(projects ?? []).map((project) => ({
      '@type': 'CreativeWork',
      name: project.org,
      url: project.url,
      description: project.description,
      creator: { '@id': personById },
    })),
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      window.gtag = gtag;
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500,
      });
    </script>
    <script define:vars={{ gtmId }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        const f = d.getElementsByTagName(s)[0];
        const j = d.createElement(s);
        const dl = l !== 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', gtmId);
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={lang} href={canonicalURL} />
    <link rel="alternate" hreflang={altLang} href={new URL(altPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dahiana Porto" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <noscript>
      <iframe
        class="gtm-noscript-frame"
        src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
        height="0"
        width="0"
        title="Google Tag Manager"></iframe>
    </noscript>
    <a class="skip-link" href="#main">Skip to main content</a>
    <slot name="nav" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
    <CookieConsent lang={lang} content={cookieConsent} />
  </body>
</html>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sections = document.querySelectorAll<HTMLElement>('[data-reveal]');

  if (!prefersReducedMotion && sections.length && 'IntersectionObserver' in window) {
    sections.forEach((section) => section.classList.add('reveal-pending'));

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.remove('reveal-pending');
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 },
    );

    sections.forEach((section) => observer.observe(section));
  }

  const consoleGreeting = document.documentElement.lang === 'es'
    ? '%c¡Hola :)%c\n¿Algo llamó tu atención? Si encontraste un error o algo que no debería estar ahí, escríbeme a hello@dahiana.work. ¡Gracias!'
    : "%cHello, stranger!%c\nSomething caught your attention? If you found a bug or something that shouldn't be there, email me at hello@dahiana.work. Thank you :)";

  // console.log %c styling can't read CSS custom properties — keep this hex in sync with --color-text-accent in tokens.css
  console.log(consoleGreeting, 'color:#1d4ed8;font-weight:700;', 'color:inherit;font-weight:400;');
</script>

<style>
  :global(*),
  :global(*::before),
  :global(*::after) {
    box-sizing: border-box;
  }

  :global(html) {
    background: var(--color-surface-base);
    background-image: linear-gradient(var(--grid-line-color) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line-color) 1px, transparent 1px);
    background-size: 4rem 4rem;
    color: var(--color-text-primary);
    font-family: var(--font-body);
    line-height: var(--leading-body);
  }

  :global(body) {
    margin: 0;
  }

  .gtm-noscript-frame {
    display: none;
    visibility: hidden;
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--color-text-accent);
    color: var(--color-text-on-footer);
    padding: var(--space-1) var(--space-2);
    z-index: 20;
  }

  .skip-link:focus {
    left: var(--space-2);
    top: var(--space-2);
  }

  :global([data-reveal] .reveal-item) {
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  :global([data-reveal].reveal-pending .reveal-item) {
    opacity: 0;
    transform: translateY(12px);
  }

  :global([data-reveal] .reveal-item:nth-child(2)) {
    transition-delay: 70ms;
  }

  :global([data-reveal] .reveal-item:nth-child(3)) {
    transition-delay: 140ms;
  }

  :global([data-reveal] .reveal-item:nth-child(4)) {
    transition-delay: 210ms;
  }

  :global([data-reveal] .reveal-item:nth-child(5)) {
    transition-delay: 280ms;
  }

  :global([data-reveal] .reveal-item:nth-child(6)) {
    transition-delay: 350ms;
  }

  :global([data-reveal] .reveal-item:nth-child(7)) {
    transition-delay: 420ms;
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-reveal] .reveal-item) {
      transition: none;
    }
  }
</style>
