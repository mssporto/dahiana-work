---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { es } from '../../data/content';

const { cookiePolicy: policy, cookieConsent } = es;
const categories = [cookieConsent.necessary, cookieConsent.analytics, cookieConsent.marketing];
---

<BaseLayout
  title={`${policy.heading} — Dahiana Porto`}
  description={policy.intro}
  lang="es"
  cookieConsent={es.cookieConsent}
>
  <header class="policy-header">
    <a class="back-link" href="/es/">{policy.backHomeLabel}</a>
    <a class="lang-switch" href="/cookies/" lang="en" hreflang="en">EN</a>
  </header>
  <section class="policy">
    <h1>{policy.heading}</h1>
    <p class="intro">{policy.intro}</p>

    <h2>{policy.whatAreCookiesHeading}</h2>
    <p>{policy.whatAreCookiesBody}</p>

    <h2>{policy.typesHeading}</h2>
    <p>{policy.typesBody}</p>

    <h2>{policy.tableHeading}</h2>
    {
      categories.map((category) => (
        <div class="category">
          <h3>{category.title}</h3>
          <p>{category.description}</p>
          {category.cookies.length > 0 && (
            <table>
              <thead>
                <tr>
                  <th scope="col">{cookieConsent.cookieTableHeaders.name}</th>
                  <th scope="col">{cookieConsent.cookieTableHeaders.provider}</th>
                  <th scope="col">{cookieConsent.cookieTableHeaders.duration}</th>
                  <th scope="col">{cookieConsent.cookieTableHeaders.description}</th>
                </tr>
              </thead>
              <tbody>
                {category.cookies.map((cookie) => (
                  <tr>
                    <td data-label={cookieConsent.cookieTableHeaders.name}>{cookie.name}</td>
                    <td data-label={cookieConsent.cookieTableHeaders.provider}>{cookie.provider}</td>
                    <td data-label={cookieConsent.cookieTableHeaders.duration}>{cookie.duration}</td>
                    <td data-label={cookieConsent.cookieTableHeaders.description}>{cookie.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>
      ))
    }

    <h2>{policy.disableHeading}</h2>
    <p>{policy.disableBody}</p>
    <ul class="browser-links">
      {
        policy.browserLinks.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <h2>{policy.manageHeading}</h2>
    <p>{policy.manageBody}</p>
    <button type="button" class="manage-btn" data-cc="show-preferencesModal">
      {policy.manageButton}
    </button>

    <p class="contact">{policy.contactBody}</p>
  </section>
</BaseLayout>

<style>
  .policy-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--grid-line-color);
  }

  .back-link,
  .lang-switch {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-text-primary);
    text-decoration: none;
    border: 1px solid var(--color-text-primary);
    border-radius: 2px;
    padding: var(--space-1) var(--space-2);
    transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .back-link:hover,
  .lang-switch:hover {
    background: var(--color-text-accent);
    border-color: var(--color-text-accent);
    color: var(--color-text-on-footer);
    transform: translateY(-1px);
  }

  .back-link:focus-visible,
  .lang-switch:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 2px;
  }

  .back-link:active,
  .lang-switch:active {
    transform: translateY(0) scale(0.97);
  }

  .policy {
    padding: var(--space-8) var(--space-3) var(--space-12);
    max-width: 42rem;
    margin: 0 auto;
    color: var(--color-text-muted);
    line-height: var(--leading-body);
  }

  .policy h1 {
    font-family: var(--font-display);
    font-size: var(--font-size-heading);
    color: var(--color-text-primary);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-3);
  }

  .policy h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: var(--space-6) 0 var(--space-2);
  }

  .policy h3 {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: var(--space-4) 0 var(--space-1);
  }

  .intro {
    font-size: 1.125rem;
  }

  .category {
    margin-bottom: var(--space-3);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-2) 0 var(--space-4);
    font-size: var(--font-size-meta);
  }

  th,
  td {
    text-align: left;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--grid-line-color);
    vertical-align: top;
  }

  th {
    color: var(--color-text-primary);
    font-weight: 700;
    background: var(--grid-line-color);
  }

  .browser-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0 0;
  }

  .browser-links a {
    color: var(--color-text-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .browser-links a:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 2px;
  }

  .manage-btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-text-primary);
    background: transparent;
    border: 1px solid var(--color-text-primary);
    border-radius: 2px;
    padding: var(--space-1) var(--space-2);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .manage-btn:hover {
    background: var(--color-text-accent);
    border-color: var(--color-text-accent);
    color: var(--color-text-on-footer);
    transform: translateY(-1px);
  }

  .manage-btn:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 2px;
  }

  .manage-btn:active {
    transform: translateY(0) scale(0.97);
  }

  .contact {
    margin-top: var(--space-6);
  }

  @media (prefers-reduced-motion: reduce) {
    .manage-btn,
    .back-link,
    .lang-switch {
      transition: background-color 0.15s ease, color 0.15s ease;
    }

    .manage-btn:hover,
    .back-link:hover,
    .lang-switch:hover {
      transform: none;
    }
  }
</style>
