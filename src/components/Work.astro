---
import type { Project } from '../data/content';

interface Props {
  heading: string;
  projects: Project[];
}
const { heading, projects } = Astro.props;

const activeProject = projects[0];

function domainFor(url: string): string {
  return new URL(url).hostname.replace(/^www\./, '');
}
---

<section class="work" id="work" aria-labelledby="work-heading" data-reveal>
  <h2 id="work-heading" class="section-heading reveal-item">{heading}</h2>

  <div class="carousel reveal-item" data-carousel role="group" aria-label={heading} tabindex="0">
    <div class="stack">
      {
        projects.map((project, i) => (
          <a
            class="card"
            class:list={{ 'is-active': i === 0 }}
            style={`--diff: ${Math.max(-3, Math.min(3, i))}`}
            data-index={i}
            data-org={project.org}
            data-description={project.description}
            href={project.url}
            target="_blank"
            rel="noopener noreferrer nofollow"
          >
            <span class="card-face">
              <span class="card-chrome">
                <span class="chrome-dot chrome-dot--accent"></span>
                <span class="chrome-dot"></span>
                <span class="chrome-dot"></span>
                <span class="chrome-domain">{domainFor(project.url)}</span>
              </span>
              <span class="card-viewport">
                <img
                  src={project.image}
                  alt={`${project.org} website preview`}
                  loading="lazy"
                  decoding="async"
                />
              </span>
            </span>
          </a>
        ))
      }
    </div>

    <p class="active-info" aria-live="polite">
      <strong class="active-org">{activeProject.org}</strong> — <span class="active-desc">{activeProject.description}</span>
    </p>

    <div class="controls">
      <button type="button" class="control-btn" data-prev aria-label="Previous project">‹</button>
      <div class="dots" role="group" aria-label="Select a project">
        {
          projects.map((project, i) => (
            <button
              type="button"
              class="dot"
              data-dot={i}
              aria-label={`Go to ${project.org}`}
              aria-current={i === 0 ? 'true' : undefined}
            />
          ))
        }
      </div>
      <button type="button" class="control-btn" data-next aria-label="Next project">›</button>
    </div>
  </div>
</section>

<script>
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');
  if (carousel) {
    const cards = Array.from(carousel.querySelectorAll<HTMLAnchorElement>('.card'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('.dot'));
    const prevBtn = carousel.querySelector<HTMLButtonElement>('[data-prev]');
    const nextBtn = carousel.querySelector<HTMLButtonElement>('[data-next]');
    const activeOrg = carousel.querySelector<HTMLElement>('.active-org');
    const activeDesc = carousel.querySelector<HTMLElement>('.active-desc');

    let activeIndex = 0;

    function render() {
      cards.forEach((card, i) => {
        const diff = i - activeIndex;
        const clampedDiff = Math.max(-3, Math.min(3, diff));
        card.style.setProperty('--diff', String(clampedDiff));
        card.style.zIndex = String(cards.length - Math.abs(diff));
        card.classList.toggle('is-active', i === activeIndex);
      });

      dots.forEach((dot, i) => {
        if (i === activeIndex) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });

      const active = cards[activeIndex];
      if (active && activeOrg && activeDesc) {
        activeOrg.textContent = active.dataset.org ?? '';
        activeDesc.textContent = active.dataset.description ?? '';
      }
    }

    function setActive(index: number) {
      activeIndex = Math.max(0, Math.min(cards.length - 1, index));
      render();
    }

    cards.forEach((card, i) => {
      card.addEventListener('click', (event) => {
        if (i !== activeIndex) {
          event.preventDefault();
          setActive(i);
        }
      });
    });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => setActive(i));
    });

    prevBtn?.addEventListener('click', () => setActive(activeIndex - 1));
    nextBtn?.addEventListener('click', () => setActive(activeIndex + 1));

    carousel.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        setActive(activeIndex - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        setActive(activeIndex + 1);
      }
    });

    render();
  }
</script>

<style>
  .work {
    padding: 0 var(--space-3) var(--space-8);
    max-width: 64rem;
    margin: 0 auto;
    scroll-margin-top: 5rem;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: var(--font-size-heading);
    font-weight: var(--font-weight-heading);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-4);
  }

  .carousel {
    --card-width: clamp(11rem, 55vw, 31.25rem);
    --card-height: clamp(8.8rem, 44vw, 25rem);
    --fan-offset: calc(var(--card-width) * 0.38);
    --fan-rotate: 6deg;
    --card-scale: 0.85;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .carousel:hover,
  .carousel:focus-within {
    --fan-rotate: 14deg;
    --card-scale: 0.72;
  }

  .carousel:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 4px;
  }

  .stack {
    position: relative;
    width: 100%;
    height: calc(var(--card-height) + var(--space-4));
    overflow: hidden;
  }

  .card {
    position: absolute;
    left: 50%;
    top: var(--space-2);
    width: var(--card-width);
    height: var(--card-height);
    margin-left: calc(var(--card-width) / -2);
    display: block;
    color: inherit;
    text-decoration: none;
    transform: translateX(calc(var(--diff) * var(--fan-offset))) rotate(calc(var(--diff) * var(--fan-rotate)))
      scale(var(--card-scale));
    transition: transform 0.4s ease;
  }

  .card.is-active {
    transform: translateX(calc(var(--diff) * var(--fan-offset))) rotate(calc(var(--diff) * var(--fan-rotate))) scale(1.05);
  }

  .card:focus-visible .card-face {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 2px;
  }

  .card-face {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    border-radius: 2px;
    overflow: hidden;
    border: 1px solid var(--grid-line-color);
  }

  .card-chrome {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: var(--space-1);
    height: 1.5rem;
    padding: 0 var(--space-1);
    background-color: var(--color-surface-base);
  }

  .chrome-dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background-color: var(--color-text-primary);
    opacity: 0.3;
  }

  .chrome-dot--accent {
    background-color: var(--color-text-accent);
    opacity: 1;
  }

  .chrome-domain {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-text-muted);
    margin-left: auto;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-viewport {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: var(--color-text-primary);
  }

  .card-viewport img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
  }

  .active-info {
    max-width: 32rem;
    text-align: center;
    margin: 0;
    color: var(--color-text-muted);
    line-height: var(--leading-body);
    font-size: var(--font-size-body);
  }

  .active-org {
    color: var(--color-text-primary);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .control-btn {
    font-family: var(--font-mono);
    font-size: var(--font-size-body);
    color: var(--color-text-primary);
    background: none;
    border: 1px solid var(--color-text-primary);
    border-radius: 2px;
    min-width: 2.75rem;
    min-height: 2.75rem;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .control-btn:hover {
    background-color: var(--color-text-accent);
    color: var(--color-text-primary);
    border-color: var(--color-text-accent);
  }

  .control-btn:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 2px;
  }

  .dots {
    display: flex;
    gap: var(--space-1);
  }

  .dot {
    width: 1.75rem;
    height: 1.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
  }

  .dot::after {
    content: '';
    display: block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 2px;
    border: 1px solid var(--color-text-primary);
  }

  .dot[aria-current='true']::after {
    background-color: var(--color-text-accent);
    border-color: var(--color-text-accent);
  }

  .dot:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }
</style>
