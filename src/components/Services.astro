---
interface Props {
  servicesHeading: string;
  services: string[];
}
const { servicesHeading, services } = Astro.props;
---

<section class="services" id="services" aria-labelledby="services-heading">
  <h2 id="services-heading" class="section-heading">{servicesHeading}</h2>
  <ul class="list">
    {services.map((service) => <li>{service}</li>)}
  </ul>
</section>

<style>
  .services {
    padding: 0 var(--space-3) var(--space-8);
    max-width: 42rem;
    margin: 0 auto;
    scroll-margin-top: 5rem;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: var(--font-size-heading);
    font-weight: var(--font-weight-heading);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-3);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--color-text-muted);
    line-height: var(--leading-body);
    font-size: clamp(1rem, 0.5vw + 0.9rem, 1.125rem);
  }
</style>
