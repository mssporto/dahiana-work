---
import type { Service } from '../data/content';

interface Props {
  servicesHeading: string;
  services: Service[];
}
const { servicesHeading, services } = Astro.props;
---

<section class="services" id="services" aria-labelledby="services-heading" data-reveal>
  <h2 id="services-heading" class="section-heading reveal-item">{servicesHeading}</h2>
  <ul class="list">
    {
      services.map((service) => (
        <li class="reveal-item">
          <p class="service-text">{service.text}</p>
          <ul class="tags">
            {service.tags.map((tag) => (
              <li class="tag">{tag}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .services {
    padding: 0 var(--space-3) var(--space-8);
    max-width: 42rem;
    margin: 0 auto;
    scroll-margin-top: 5rem;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: var(--font-size-heading);
    font-weight: var(--font-weight-heading);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-3);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .service-text {
    margin: 0 0 var(--space-2);
    color: var(--color-text-muted);
    line-height: var(--leading-body);
    font-size: clamp(1rem, 0.5vw + 0.9rem, 1.125rem);
  }

  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .tag {
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    color: var(--color-text-primary);
    border: 1px solid var(--color-text-primary);
    border-radius: 2px;
    padding: var(--space-1) var(--space-2);
    transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  [data-reveal].reveal-pending .tag {
    opacity: 0;
    transform: scale(0.8);
  }

  .tags .tag:nth-child(2) {
    transition-delay: 60ms;
  }

  .tags .tag:nth-child(3) {
    transition-delay: 120ms;
  }

  .tag:hover {
    transform: scale(1.08) rotate(-2deg) translateY(-3px);
    background-color: var(--color-text-accent);
    border-color: var(--color-text-accent);
    color: var(--color-text-on-footer);
  }

  @media (prefers-reduced-motion: reduce) {
    .tag {
      transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }

    .tag:hover {
      transform: none;
    }
  }
</style>
