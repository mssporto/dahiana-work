---
interface Props {
  ctaText: string;
  ctaEmail: string;
}
const { ctaText, ctaEmail } = Astro.props;
---

<footer class="footer" id="contact" aria-labelledby="contact-heading">
  <div class="footer-inner">
    <h2 id="contact-heading" class="visually-hidden">Contact</h2>
    <p class="cta-text">{ctaText}</p>
    <a class="sticker" href={`mailto:${ctaEmail}`}>
      <span>{ctaEmail}</span>
    </a>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-surface-footer);
    padding: var(--space-12) var(--space-3);
    scroll-margin-top: 5rem;
  }

  .footer-inner {
    max-width: 42rem;
    margin: 0 auto;
    text-align: center;
  }

  .cta-text {
    font-size: clamp(1.25rem, 1.5vw + 1rem, 1.75rem);
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-text-on-footer);
    margin: 0 0 var(--space-6);
  }

  .sticker {
    position: relative;
    display: inline-block;
    background: var(--color-text-accent);
    color: var(--color-text-primary);
    font-weight: 700;
    font-size: var(--font-size-body);
    padding: var(--space-3) var(--space-4);
    text-decoration: none;
    transform: rotate(-2deg);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.38);
    transition: transform 0.2s ease;
  }

  .sticker::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 0.9rem;
    height: 0.9rem;
    background: linear-gradient(135deg, rgba(19, 20, 16, 0.25) 50%, transparent 51%);
  }

  .sticker:hover {
    transform: rotate(-2deg) translateY(-3px);
  }

  .sticker:focus-visible {
    outline: 2px solid var(--color-text-on-footer);
    outline-offset: 3px;
  }

  .sticker:active {
    transform: rotate(-2deg) translateY(0);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
