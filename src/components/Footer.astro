---
interface Props {
  ctaText: string;
  ctaEmail: string;
}
const { ctaText, ctaEmail } = Astro.props;
---

<footer class="footer" id="contact" aria-labelledby="contact-heading">
  <div class="footer-inner">
    <h2 id="contact-heading" class="visually-hidden">Contact</h2>
    <p class="cta-text">{ctaText}</p>
    <a class="email-cta" href={`mailto:${ctaEmail}`}>
      <span class="envelope" aria-hidden="true">
        <img src="/images/envelope-3d.png" alt="" width="256" height="256" loading="lazy" />
      </span>
      <span class="email-link">{ctaEmail}</span>
    </a>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-surface-footer);
    padding: var(--space-12) var(--space-3);
    scroll-margin-top: 5rem;
  }

  .footer-inner {
    max-width: 42rem;
    margin: 0 auto;
    text-align: center;
  }

  .cta-text {
    font-size: clamp(1.25rem, 1.5vw + 1rem, 1.75rem);
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-text-on-footer);
    margin: 0 0 var(--space-6);
  }

  .email-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .email-cta:hover {
    transform: translateY(-2px);
    opacity: 0.8;
  }

  .email-cta:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 3px;
  }

  .email-cta:active {
    transform: translateY(0);
    opacity: 1;
  }

  .envelope {
    display: inline-block;
    width: clamp(1.75rem, 2.5vw + 1rem, 2.75rem);
    transform-origin: 50% 60%;
    animation: envelope-idle 3.6s ease-in-out infinite;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.45));
  }

  .envelope img {
    display: block;
    width: 100%;
    height: 100%;
  }

  @keyframes envelope-idle {
    0%,
    60%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    15% {
      transform: translateY(-6px) rotate(-3deg);
    }
    30% {
      transform: translateY(0) rotate(3deg);
    }
    45% {
      transform: translateY(-3px) rotate(-1deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .envelope {
      animation: none;
    }
  }

  .email-link {
    font-family: var(--font-mono);
    font-size: var(--font-size-body);
    font-weight: 700;
    color: var(--color-text-on-footer);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
