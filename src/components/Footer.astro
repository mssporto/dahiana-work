---
import { Image } from 'astro:assets';
import envelope3d from '../images/envelope-3d.png';

interface Props {
  ctaText: string;
  ctaEmail: string;
  copyLabel: string;
  copiedLabel: string;
}
const { ctaText, ctaEmail, copyLabel, copiedLabel } = Astro.props;
---

<footer class="footer" id="contact" aria-labelledby="contact-heading" data-reveal>
  <div class="footer-inner">
    <h2 id="contact-heading" class="visually-hidden">Contact</h2>
    <p class="cta-text reveal-item">{ctaText}</p>
    <div class="contact-row reveal-item">
      <a class="email-cta" href={`mailto:${ctaEmail}`}>
        <span class="envelope" aria-hidden="true">
          <Image src={envelope3d} alt="" width={88} height={88} loading="lazy" />
        </span>
        <span class="email-link">{ctaEmail}</span>
      </a>
      <button
        type="button"
        class="copy-btn"
        data-copy-email={ctaEmail}
        data-copy-label={copyLabel}
        data-copied-label={copiedLabel}
        aria-label={copyLabel}
      >
        <svg class="icon icon-copy" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <rect x="3.5" y="3.5" width="9" height="9" rx="1.25" fill="none" stroke="currentColor" stroke-width="1.5" />
          <rect x="7.5" y="7.5" width="9" height="9" rx="1.25" fill="none" stroke="currentColor" stroke-width="1.5" />
        </svg>
        <svg class="icon icon-check" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <path d="M4 10.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>
</footer>

<script>
  const copyBtn = document.querySelector<HTMLButtonElement>('.copy-btn');
  if (copyBtn) {
    let resetTimer: ReturnType<typeof setTimeout>;
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.dataset.copyEmail ?? '';
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        return;
      }
      clearTimeout(resetTimer);
      copyBtn.classList.add('is-copied');
      copyBtn.setAttribute('aria-label', copyBtn.dataset.copiedLabel ?? '');
      resetTimer = setTimeout(() => {
        copyBtn.classList.remove('is-copied');
        copyBtn.setAttribute('aria-label', copyBtn.dataset.copyLabel ?? '');
      }, 1800);
    });
  }
</script>

<style>
  .footer {
    background: var(--color-surface-footer);
    padding: clamp(var(--space-12), 14vw, var(--space-16)) var(--space-3);
    scroll-margin-top: 5rem;
  }

  .footer-inner {
    max-width: 42rem;
    margin: 0 auto;
    text-align: center;
  }

  .cta-text {
    font-size: clamp(1.375rem, 2vw + 1rem, 2rem);
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-text-on-footer);
    margin: 0 0 var(--space-8);
  }

  .contact-row {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .email-cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    gap: var(--space-2);
    text-decoration: none;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .email-cta:hover {
    transform: translateY(-2px) scale(1.02);
    opacity: 0.8;
  }

  .email-cta:focus-visible {
    outline: 2px solid var(--color-text-accent-on-dark);
    outline-offset: 3px;
  }

  .email-cta:active {
    transform: translateY(0) scale(0.98);
    opacity: 1;
  }

  .envelope {
    display: inline-block;
    width: clamp(2rem, 3vw + 1rem, 3.25rem);
    transform-origin: 50% 60%;
    animation: envelope-idle 3.6s ease-in-out infinite;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.45));
  }

  .envelope img {
    display: block;
    width: 100%;
    height: 100%;
  }

  @keyframes envelope-idle {
    0%,
    60%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    15% {
      transform: translateY(-6px) rotate(-3deg);
    }
    30% {
      transform: translateY(0) rotate(3deg);
    }
    45% {
      transform: translateY(-3px) rotate(-1deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .envelope {
      animation: none;
    }
  }

  .email-link {
    font-family: var(--font-mono);
    font-size: clamp(1.125rem, 1.2vw + 0.9rem, 1.5rem);
    font-weight: 700;
    color: var(--color-text-on-footer);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .copy-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
    color: var(--color-text-on-footer);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1), color 0.15s ease;
  }

  .copy-btn:hover {
    transform: translateY(-1px);
    color: var(--color-text-accent-on-dark);
  }

  .copy-btn:active {
    transform: translateY(0) scale(0.9);
  }

  .copy-btn:focus-visible {
    outline: 2px solid var(--color-text-accent-on-dark);
    outline-offset: 3px;
  }

  .icon {
    position: absolute;
    width: 0.8125rem;
    height: 0.8125rem;
    transition: opacity 0.2s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .icon-check {
    color: var(--color-text-accent-on-dark);
    opacity: 0;
    transform: scale(0.5);
  }

  .icon-copy {
    opacity: 1;
    transform: scale(1);
  }

  .copy-btn.is-copied .icon-copy {
    opacity: 0;
    transform: scale(0.5);
  }

  .copy-btn.is-copied .icon-check {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .copy-btn,
    .copy-btn:hover,
    .copy-btn:active {
      transition: border-color 0.15s ease, background-color 0.15s ease;
      transform: none;
    }

    .icon {
      transition: opacity 0.15s ease;
      transform: none !important;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
