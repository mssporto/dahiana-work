---
import { Image } from 'astro:assets';
import wavingHand from '../images/waving-hand-3d.png';

interface Props {
  greeting: string;
}
const { greeting } = Astro.props;
---

<section class="hero">
  <h1 class="hero-title">
    {greeting}
    <span class="hand" aria-hidden="true">
      <Image src={wavingHand} alt="" width={144} height={144} loading="eager" />
    </span>
  </h1>
</section>

<style>
  .hero {
    padding: var(--space-12) var(--space-3) var(--space-8);
    max-width: 42rem;
    margin: 0 auto;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: var(--font-size-hero);
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    line-height: 1.05;
    margin: 0;
    color: var(--color-text-primary);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .hand {
    display: inline-block;
    width: clamp(2.5rem, 5vw + 1.5rem, 4.5rem);
    transform-origin: 70% 70%;
    animation: hand-idle 3.2s ease-in-out infinite;
    filter: drop-shadow(0 4px 10px rgba(19, 20, 16, 0.25));
  }

  .hand img {
    display: block;
    width: 100%;
    height: 100%;
  }

  @keyframes hand-idle {
    0%,
    55%,
    100% {
      transform: rotate(0deg) scale(1);
    }
    10% {
      transform: rotate(14deg) scale(1.03);
    }
    20% {
      transform: rotate(-8deg) scale(1.03);
    }
    30% {
      transform: rotate(14deg) scale(1.03);
    }
    40% {
      transform: rotate(-4deg) scale(1.01);
    }
    50% {
      transform: rotate(10deg) scale(1.01);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hand {
      animation: none;
    }
  }
</style>
