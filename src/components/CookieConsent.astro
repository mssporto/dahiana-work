---
import 'vanilla-cookieconsent/dist/cookieconsent.css';
import type { CookieCategoryCopy, CookieConsentCopy } from '../data/content';

interface Props {
  lang: 'en' | 'es';
  content: CookieConsentCopy;
}

const { lang, content } = Astro.props;

function toSection(category: CookieCategoryCopy, linkedCategory: string) {
  const headers = content.cookieTableHeaders;
  return {
    title: category.title,
    description: category.description,
    linkedCategory,
    ...(category.cookies.length > 0 && {
      cookieTable: {
        headers: { name: headers.name, provider: headers.provider, duration: headers.duration, description: headers.description },
        body: category.cookies.map((cookie) => ({
          name: cookie.name,
          provider: cookie.provider,
          duration: cookie.duration,
          description: cookie.description,
        })),
      },
    }),
  };
}

const translations = {
  consentModal: {
    title: content.title,
    description: content.description,
    acceptAllBtn: content.acceptAllBtn,
    acceptNecessaryBtn: content.acceptNecessaryBtn,
    showPreferencesBtn: content.showPreferencesBtn,
    closeIconLabel: content.closeIconLabel,
  },
  preferencesModal: {
    title: content.preferencesTitle,
    acceptAllBtn: content.acceptAllBtn,
    acceptNecessaryBtn: content.acceptNecessaryBtn,
    savePreferencesBtn: content.savePreferencesBtn,
    closeIconLabel: content.closeIconLabel,
    sections: [
      toSection(content.necessary, 'necessary'),
      toSection(content.analytics, 'analytics'),
      toSection(content.marketing, 'marketing'),
    ],
  },
};
---

<div id="cc-main" data-lang={lang} data-translations={JSON.stringify(translations)}></div>

<script>
  import { run } from 'vanilla-cookieconsent';

  declare global {
    interface Window {
      dataLayer: unknown[][];
      gtag: (...args: unknown[]) => void;
    }
  }

  const root = document.getElementById('cc-main');
  if (root) {
    const lang = root.dataset.lang ?? 'en';
    const translations = JSON.parse(root.dataset.translations ?? '{}');

    function pushConsentUpdate(cookie: { categories: string[] }) {
      const granted = (category: string) => (cookie.categories.includes(category) ? 'granted' : 'denied');
      window.dataLayer = window.dataLayer || [];
      window.gtag('consent', 'update', {
        analytics_storage: granted('analytics'),
        ad_storage: granted('marketing'),
        ad_user_data: granted('marketing'),
        ad_personalization: granted('marketing'),
      });
    }

    run({
      root: '#cc-main',
      guiOptions: {
        consentModal: { layout: 'bar', position: 'bottom', equalWeightButtons: true },
        preferencesModal: { layout: 'box', equalWeightButtons: true },
      },
      categories: {
        necessary: { enabled: true, readOnly: true },
        analytics: { autoClear: { cookies: [{ name: /^_ga/ }] } },
        marketing: {},
      },
      language: {
        default: lang,
        translations: { [lang]: translations },
      },
      onFirstConsent: ({ cookie }) => pushConsentUpdate(cookie),
      onConsent: ({ cookie }) => pushConsentUpdate(cookie),
      onChange: ({ cookie }) => pushConsentUpdate(cookie),
    });
  }
</script>

<style>
  #cc-main {
    --cc-font-family: var(--font-body);
    --cc-primary-color: var(--color-text-primary);
    --cc-secondary-color: var(--color-text-muted);
    --cc-bg: var(--color-surface-base);
    --cc-modal-border-radius: 2px;
    --cc-modal-margin: var(--space-3);

    --cc-btn-border-radius: 2px;
    --cc-btn-primary-bg: var(--color-text-accent);
    --cc-btn-primary-color: var(--color-text-on-footer);
    --cc-btn-primary-border-color: var(--color-text-accent);
    --cc-btn-primary-hover-bg: color-mix(in srgb, var(--color-text-accent) 85%, black);
    --cc-btn-primary-hover-color: var(--color-text-on-footer);
    --cc-btn-primary-hover-border-color: color-mix(in srgb, var(--color-text-accent) 85%, black);

    --cc-btn-secondary-bg: transparent;
    --cc-btn-secondary-color: var(--color-text-primary);
    --cc-btn-secondary-border-color: var(--color-text-primary);
    --cc-btn-secondary-hover-bg: var(--color-text-accent);
    --cc-btn-secondary-hover-color: var(--color-text-on-footer);
    --cc-btn-secondary-hover-border-color: var(--color-text-accent);

    --cc-toggle-on-bg: var(--color-text-accent);
    --cc-toggle-on-knob-bg: var(--color-surface-base);
    --cc-toggle-off-bg: var(--color-text-muted);
    --cc-toggle-off-knob-bg: var(--color-surface-base);
    --cc-toggle-readonly-bg: var(--grid-line-color);
    --cc-toggle-readonly-knob-bg: var(--color-text-muted);
    --cc-toggle-readonly-knob-icon-color: var(--color-surface-base);
    --cc-toggle-enabled-icon-color: var(--color-surface-base);
    --cc-toggle-disabled-icon-color: var(--color-surface-base);

    --cc-cookie-category-block-bg: var(--color-surface-base);
    --cc-cookie-category-block-border: var(--grid-line-color);
    --cc-cookie-category-block-hover-bg: var(--grid-line-color);
    --cc-cookie-category-expanded-block-bg: var(--color-surface-base);
    --cc-cookie-category-expanded-block-hover-bg: var(--grid-line-color);
    --cc-section-category-border: var(--grid-line-color);
    --cc-separator-border-color: var(--grid-line-color);

    --cc-footer-bg: var(--color-surface-base);
    --cc-footer-border-color: var(--grid-line-color);
    --cc-footer-color: var(--color-text-primary);

    --cc-overlay-bg: rgba(10, 10, 8, 0.6);
    --cc-webkit-scrollbar-bg: var(--grid-line-color);
    --cc-webkit-scrollbar-hover-bg: var(--color-text-muted);
  }

  /* Links inside the banner/panel are JS-injected by the library, so they need
     the site's .inline-link treatment applied explicitly rather than inherited. */
  :global(#cc-main a) {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-underline-offset: 0.2em;
    transition: color 0.15s ease;
  }

  :global(#cc-main a:hover),
  :global(#cc-main a:focus-visible) {
    color: var(--color-text-accent);
  }

  :global(#cc-main a:focus-visible) {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 2px;
    border-radius: 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(#cc-main a) {
      transition: none;
    }
  }
</style>
