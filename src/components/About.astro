---
import type { AboutParagraph } from '../data/content';

interface Props {
  about: AboutParagraph[];
}
const { about } = Astro.props;

function splitOnHighlight({ text, highlight }: AboutParagraph) {
  const index = text.indexOf(highlight);
  if (index === -1) return { before: text, highlight: '', after: '' };
  return {
    before: text.slice(0, index),
    highlight,
    after: text.slice(index + highlight.length),
  };
}
---

<section class="about" id="about" aria-labelledby="about-heading" data-reveal>
  <h2 id="about-heading" class="visually-hidden">About</h2>
  {
    about.map((paragraph) => {
      const { before, highlight, after } = splitOnHighlight(paragraph);
      return (
        <p class="about-copy reveal-item">
          {before}
          {highlight && <span class="accent-highlight">{highlight}</span>}
          {after}
        </p>
      );
    })
  }
</section>

<style>
  .about {
    padding: 0 var(--space-3) var(--space-8);
    max-width: 42rem;
    margin: 0 auto;
    scroll-margin-top: 5rem;
  }

  .about-copy {
    font-size: clamp(1.125rem, 1vw + 1rem, 1.375rem);
    font-weight: 400;
    line-height: var(--leading-body);
    color: var(--color-text-muted);
    max-width: 38rem;
    margin: 0 0 var(--space-3);
  }

  .accent-highlight {
    color: var(--color-text-accent);
    font-weight: 700;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
