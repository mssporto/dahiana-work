---
import type { NavLabels } from '../data/content';

interface Props {
  nav: NavLabels;
  statusLine: string;
  langHref: string;
  langLabel: string;
}
const { nav, statusLine, langHref, langLabel } = Astro.props;
---

<header class="site-nav">
  <nav class="links" aria-label="Sections">
    <a href="#about">{nav.about}</a>
    <a href="#work">{nav.work}</a>
    <a href="#services">{nav.services}</a>
    <a href="#contact">{nav.contact}</a>
  </nav>

  <div class="readout" aria-live="off">
    <span class="dot" aria-hidden="true"></span>
    <span class="readout-time" data-readout-time hidden></span>
    <span class="readout-sep">·</span>
    <span class="readout-coords">40.417 N, 3.704 W</span>
    <span class="readout-sep">·</span>
    <span class="readout-status">{statusLine}</span>
  </div>

  <a class="lang-switch" href={langHref} lang={langLabel.toLowerCase()} hreflang={langLabel.toLowerCase()}>
    {langLabel}
  </a>
</header>

<script>
  const timeEl = document.querySelector<HTMLElement>('[data-readout-time]');

  function updateTime() {
    if (!timeEl) return;
    const formatter = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Europe/Madrid',
      hour: '2-digit',
      minute: '2-digit',
    });
    timeEl.textContent = `${formatter.format(new Date())} Madrid`;
    timeEl.hidden = false;
  }

  updateTime();
  setInterval(updateTime, 30_000);
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface-base);
    border-bottom: 1px solid var(--grid-line-color);
  }

  .links {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  @media (max-width: 500px) {
    .site-nav {
      flex-wrap: nowrap;
    }

    .links {
      flex: 1 1 auto;
      flex-wrap: nowrap;
      min-width: 0;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      /* fade hint that the strip scrolls, without a hard edge */
      mask-image: linear-gradient(to right, black calc(100% - 1.5rem), transparent 100%);
    }

    .links::-webkit-scrollbar {
      display: none;
    }

    .links a {
      flex-shrink: 0;
      scroll-snap-align: start;
    }

    .lang-switch {
      flex-shrink: 0;
    }
  }

  .links a {
    position: relative;
    z-index: 0;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-text-primary);
    text-decoration: none;
    letter-spacing: var(--tracking-tight);
    border: 1px solid var(--color-text-primary);
    border-radius: 2px;
    padding: var(--space-1) var(--space-2);
    transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .links a::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-text-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .links a:hover {
    transform: translateY(-1px);
  }

  .links a:hover::before {
    transform: scaleX(1);
  }

  .links a:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 2px;
  }

  .links a:active {
    transform: translateY(0) scale(0.97);
  }

  .readout {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    row-gap: var(--space-1);
    max-width: min(90vw, 34rem);
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-text-muted);
  }

  .dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-status-live);
    flex-shrink: 0;
  }

  .dot::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--color-status-live);
    opacity: 0.6;
    animation: dot-ping 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes dot-ping {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot::before {
      animation: none;
      opacity: 0;
    }
  }

  .readout-sep {
    opacity: 0.5;
  }

  .lang-switch {
    position: relative;
    z-index: 0;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-text-primary);
    text-decoration: none;
    border: 1px solid var(--color-text-primary);
    border-radius: 2px;
    padding: var(--space-1) var(--space-2);
    transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lang-switch::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-text-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lang-switch:hover {
    transform: translateY(-1px) rotate(-2deg);
  }

  .lang-switch:hover::before {
    transform: scaleX(1);
  }

  .lang-switch:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 2px;
  }

  .lang-switch:active {
    transform: translateY(0) scale(0.97);
  }

  @media (max-width: 1200px) {
    .readout {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .links a,
    .lang-switch {
      transition: background-color 0.15s ease;
    }

    .links a:hover,
    .lang-switch:hover {
      transform: none;
      background-color: var(--color-text-accent);
    }

    .links a::before,
    .lang-switch::before {
      display: none;
    }
  }
</style>
