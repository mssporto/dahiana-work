---
import type { NavLabels } from '../data/content';

interface Props {
  nav: NavLabels;
  statusLine: string;
  langHref: string;
  langLabel: string;
}
const { nav, statusLine, langHref, langLabel } = Astro.props;
---

<header class="site-nav">
  <nav class="links" aria-label="Sections">
    <a href="#about">{nav.about}</a>
    <a href="#work">{nav.work}</a>
    <a href="#services">{nav.services}</a>
    <a href="#contact">{nav.contact}</a>
  </nav>

  <div class="readout" aria-live="off">
    <span class="dot" aria-hidden="true"></span>
    <span class="readout-time" data-readout-time hidden></span>
    <span class="readout-sep">·</span>
    <span class="readout-coords">40.417 N, 3.704 W</span>
    <span class="readout-sep">·</span>
    <span class="readout-status">{statusLine}</span>
  </div>

  <a class="lang-switch" href={langHref} lang={langLabel.toLowerCase()} hreflang={langLabel.toLowerCase()}>
    {langLabel}
  </a>
</header>

<script>
  const timeEl = document.querySelector<HTMLElement>('[data-readout-time]');

  function updateTime() {
    if (!timeEl) return;
    const formatter = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Europe/Madrid',
      hour: '2-digit',
      minute: '2-digit',
    });
    timeEl.textContent = `${formatter.format(new Date())} Madrid`;
    timeEl.hidden = false;
  }

  updateTime();
  setInterval(updateTime, 30_000);
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface-base);
    border-bottom: 1px solid var(--grid-line-color);
  }

  .links {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  .links a {
    position: relative;
    z-index: 0;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-text-primary);
    text-decoration: none;
    letter-spacing: var(--tracking-tight);
    border: 1px solid var(--color-text-primary);
    border-radius: 2px;
    padding: var(--space-1) var(--space-2);
    transition: transform 0.15s ease;
  }

  .links a::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-text-accent);
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .links a:hover {
    transform: translateY(-1px);
  }

  .links a:hover::before {
    opacity: 1;
  }

  .links a:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 2px;
  }

  .links a:active {
    transform: translateY(0);
  }

  .readout {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-text-muted);
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-text-accent);
    flex-shrink: 0;
  }

  .readout-sep {
    opacity: 0.5;
  }

  .lang-switch {
    position: relative;
    z-index: 0;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-text-primary);
    text-decoration: none;
    border: 1px solid var(--color-text-primary);
    border-radius: 2px;
    padding: var(--space-1) var(--space-2);
    transition: transform 0.15s ease;
  }

  .lang-switch::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-text-accent);
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .lang-switch:hover {
    transform: translateY(-1px);
  }

  .lang-switch:hover::before {
    opacity: 1;
  }

  .lang-switch:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 2px;
  }

  .lang-switch:active {
    transform: translateY(0);
  }

  @media (max-width: 768px) {
    .readout {
      display: none;
    }
  }
</style>
